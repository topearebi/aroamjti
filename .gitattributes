# =============================================================
#  .gitattributes — keep files consistent across every device/OS
#
#  You edit the same repo from iOS (Obsidian), a Linux SilverBullet host,
#  the GitHub web UI, and desktop machines. Without normalization, different
#  platforms save different invisible line endings (CRLF vs LF), which shows
#  up as "the whole file changed" in diffs and creates phantom conflicts.
#
#  This normalizes all text to LF in the repo, while letting each OS use
#  whatever it prefers in the working copy.
# =============================================================

# Default: treat everything as text and normalize line endings to LF.
* text=auto eol=lf

# --- Explicitly text (so they always normalize, never guessed as binary) ---
*.md      text eol=lf
*.markdown text eol=lf
*.html    text eol=lf
*.css     text eol=lf
*.yml     text eol=lf
*.yaml    text eol=lf
*.xml     text eol=lf
*.txt     text eol=lf
*.svg     text eol=lf
*.json    text eol=lf

# --- Explicitly binary (never normalize, never diff as text) ---
*.png     binary
*.jpg     binary
*.jpeg    binary
*.gif     binary
*.webp    binary
*.ico     binary
*.woff    binary
*.woff2   binary
*.pdf     binary
*.mp3     binary
*.mp4     binary
